# Backend runtime tuning
ALL_TOTAL_JOBS_SUMMARY_STALE_SECONDS=7200

# Sprint 1 local PostgreSQL defaults
POSTGRES_DB=agenticnetsec
POSTGRES_USER=agenticnetsec
POSTGRES_PASSWORD=agenticnetsec
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agenticnetsec:agenticnetsec@localhost:5432/agenticnetsec
AGENTIC_DATABASE_REQUIRED=0

# Sprint 4 local auth/session settings
AGENTIC_AUTH_COOKIE_NAME=agenticnetsec_session
AGENTIC_AUTH_SECRET=change-me-for-local-dev
AGENTIC_AUTH_TOKEN_SECONDS=3600
AGENTIC_AUTH_COOKIE_SECURE=0
AGENTIC_AUTH_COOKIE_SAMESITE=lax
AGENTIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional sandbox verification
AGENTIC_SANDBOX_VERIFY=0
AGENTIC_SANDBOX_MODE=auto
AGENTIC_SANDBOX_IMAGE=agenticnetsec-forensics-sandbox
AGENTIC_SANDBOX_TIMEOUT=120

# Optional AI providers. Local secrets may also be set in backend/config/local_settings.py.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost
# OPENROUTER_APP_NAME=AgenticNetSec
# REPORT_PROVIDER=openrouter
# REPORT_MODEL=openai/gpt-5-mini
# GEMINI_API_KEY=
